{
  "expo": {
    "name": "MeepleMatch",
    "slug": "meeplematch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meeplematch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.meeplematch.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.meeplematch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4A86F0",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MeepleMatch necesita acceso a tus fotos para actualizar tu imagen de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Portal para jugadores de mesa: encuentra partidas, arma tu biblioteca y conecta con otros jugadores."
  }
}
